<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Framework side of Themia.ETax.Withholding: needs the net10-only sequence allocator, so no net8 leg. Kept out of Themia.ETax.Data so
         that an app that only issues tax invoices does not pull the withholding package. -->
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Themia.ETax.Withholding.Data</PackageId>
    <Description>Database helpers for Themia.ETax.Withholding: the required immutability trigger, same-payer replacement key and issue-key uniqueness (FluentMigrator, PostgreSQL) for an app's own withholding certificate table, and the gapless certificate-number source over Themia's transactional sequence allocator.</Description>
    <PackageTags>themia;etax;withholding;migrations;postgresql;sequences</PackageTags>
    <!-- Version is inherited from Directory.Build.props (shared). Do not set it here. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Themia.ETax.Data/Themia.ETax.Data.csproj" />
    <ProjectReference Include="../../neutral/Themia.ETax.Withholding/Themia.ETax.Withholding.csproj" />
    <ProjectReference Include="../Themia.Framework.Data.Sequences/Themia.Framework.Data.Sequences.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentMigrator" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Themia.ETax.Withholding.Data.Tests" />
    <InternalsVisibleTo Include="Themia.ETax.Withholding.Data.IntegrationTests" />
  </ItemGroup>
</Project>
