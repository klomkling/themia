<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Themia.Messaging.AspNetCore</RootNamespace>
    <PackageId>Themia.Messaging.AspNetCore</PackageId>
    <Description>Themia messaging HMAC receiving side — a minimal-API endpoint filter that verifies inbound requests against themia-hmac-v1, plus the loop guard that answers 200 without invoking the endpoint when a message has come back to its own origin.</Description>
    <PackageTags>themia;messaging;hmac;aspnetcore;security;integration</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Themia.Messaging\Themia.Messaging.csproj" />
    <ProjectReference Include="..\Themia.Messaging.Hmac\Themia.Messaging.Hmac.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Themia.Messaging.AspNetCore.Tests" />
  </ItemGroup>
</Project>
