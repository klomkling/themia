<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Neutral cross-framework package: MUST include net8.0 (cross-framework reuse). -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Themia.AI.OpenAiCompatible</PackageId>
    <Description>OpenAI chat-completions-shape provider for Themia.AI's IAiCompletionProvider. One implementation reaches OpenAI, Ollama, Groq, Cerebras, LM Studio and vLLM by changing BaseUrl. Maps finish_reason and HTTP status onto AiOutcome, reads usage on every response that carries it, and sends the API key as an Authorization: Bearer header.</Description>
    <!-- Version is inherited from Directory.Build.props (shared). Do not set it here. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Themia.AI\Themia.AI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Themia.AI.OpenAiCompatible.Tests" />
  </ItemGroup>
</Project>
