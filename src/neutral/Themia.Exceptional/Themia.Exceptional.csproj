<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Neutral cross-framework package: MUST include net8.0 (cross-framework reuse). -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Themia.Exceptional</PackageId>
    <Description>Framework-neutral exception-logging engine: Serilog capture + Dapper store with a per-DB dialect strategy and FluentMigrator schema.</Description>
    <!-- Version is inherited from Directory.Build.props (shared). Do not set it here. -->
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="FluentMigrator" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Serilog" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- No ADO driver here on purpose. This assembly names no provider type: the store is Dapper over
         whatever DbConnection an IExceptionalSqlDialect hands it, and the engine packages
         (Themia.Exceptional.{PostgreSql,MySql,SqlServer}) each carry their own driver. A stray
         Microsoft.Data.SqlClient reference here put Microsoft.IdentityModel.* and Azure.Identity into
         every adopter's image, PostgreSQL-only ones included (coord #0126). -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Themia.Data.Migrations/Themia.Data.Migrations.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
