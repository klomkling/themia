<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Neutral cross-framework package: MUST include net8.0 (cross-framework reuse). -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Themia.Payments.Beam</PackageId>
    <Description>Beam Checkout adapter for Themia.Payments's IPaymentGateway: QR PromptPay and card charged directly, mobile banking and wallet through a payment link, plus webhook verification.</Description>
    <!-- Version is inherited from Directory.Build.props (shared). Do not set it here. -->
    <!-- RS0026/RS0027: BeamPaymentClient.VerifyQrSlipAsync's two overloads (raw content vs. image stream)
         each carry an optional CancellationToken by design — the brief's exact required shape. The
         optional-parameter backcompat rules do not apply to a first-shipped surface (same precedent as
         Themia.Framework.Core.csproj). -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Themia.Payments\Themia.Payments.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Themia.Payments.Beam.Tests" />
  </ItemGroup>
</Project>
