<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Neutral cross-framework package: MUST include net8.0 (cross-framework reuse). -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Themia.SecondFactor</PackageId>
    <Description>Themia multi-method second-factor layer — credential store contract, method strength, per-app/per-role policy, recovery codes and federated amr helpers over Themia.WebAuthn, Themia.Totp and Themia.Challenges. No user table, transport or framework dependency.</Description>
    <PackageTags>themia;mfa;second-factor;passkey;totp;security</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Themia.Challenges/Themia.Challenges.csproj" />
    <ProjectReference Include="../Themia.Totp/Themia.Totp.csproj" />
    <ProjectReference Include="../Themia.WebAuthn/Themia.WebAuthn.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Themia.SecondFactor.Tests" />
    <InternalsVisibleTo Include="Themia.SecondFactor.IntegrationTests" />
  </ItemGroup>
</Project>
