<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net10.0 only: Themia.Quartz (IExecutionHistoryStore, the dashboard) is net10.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Themia.Scheduling</PackageId>
    <Description>Persistent Quartz.NET scheduling without an ORM — AdoJobStore wiring, the qrtz_* and scheduling schema as FluentMigrator migrations, and System.Text.Json serialization. No EF Core, no DbContext. Reference Themia.Modules.Scheduling instead if you want the EF-backed execution-history store.</Description>
    <PackageTags>themia;scheduling;quartz;adojobstore;dapper</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Themia.Quartz/Themia.Quartz.csproj" />
    <ProjectReference Include="../Themia.Data.Migrations/Themia.Data.Migrations.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Quartz" />
    <!-- No ADO driver here on purpose. Npgsql and Microsoft.Data.SqlClient were named explicitly while
         the connection factory constructed those types directly; that reasoning rested on their being
         "already in the graph via Themia.Data.Migrations", which stopped being true when the engine
         split moved them out (coord #0116/#0117), leaving this package as the path that put
         Microsoft.IdentityModel.* and Azure.Identity into a PostgreSQL-only adopter's image
         (coord #0126). The factory now routes through IMigrationEngineAdapter.CreateConnection, so the
         driver comes from whichever single Themia.Data.Migrations.{Engine} package the adopter chose. -->
    <PackageReference Include="Dapper" />
    <PackageReference Include="Quartz.Serialization.SystemTextJson" />
    <PackageReference Include="Quartz.Extensions.Hosting" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Themia.Scheduling.Tests" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
