<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Neutral cross-framework package: MUST include net8.0 (cross-framework reuse). -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Themia.Data.Migrations</PackageId>
    <Description>Framework-neutral FluentMigrator runner: applies migrations for PostgreSQL, MySQL, and SQL Server through one engine-agnostic entry point.</Description>
    <!-- Version is inherited from Directory.Build.props (shared). Do not set it here. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- No runner, no ADO driver, no JWT stack: FluentMigrator.Runner.{Postgres,MySql,SqlServer}, Npgsql,
         MySqlConnector and Microsoft.Data.SqlClient moved to Themia.Data.Migrations.{PostgreSql,MySql,SqlServer}
         behind IMigrationEngineAdapter. See docs/superpowers/specs/2026-09-09-data-migrations-engine-split.md. -->
    <PackageReference Include="FluentMigrator" />
    <!-- FluentMigrator.Runner.Core, NOT the FluentMigrator.Runner meta-package: the meta-package depends on
         every provider (Db2/Oracle/Hana/…), which is exactly what the split exists to avoid. Runner.Core is
         the provider-agnostic half (AddFluentMigratorCore, IMigrationRunnerBuilder, IMigrationRunner) that
         each Themia.Data.Migrations.{Engine} package's own provider package (Runner.Postgres etc.) depends on. -->
    <PackageReference Include="FluentMigrator.Runner.Core" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Themia.Data.Migrations.Tests" />
    <InternalsVisibleTo Include="Themia.Data.Migrations.IntegrationTests" />
    <InternalsVisibleTo Include="Themia.Data.Migrations.PostgreSql" />
    <InternalsVisibleTo Include="Themia.Data.Migrations.MySql" />
    <InternalsVisibleTo Include="Themia.Data.Migrations.SqlServer" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build-time enforcement (spec §7): errors THEMIA2001 when an Exe consumer never brought in an
         engine package. buildTransitive/, not build/ — see the .targets file for why. -->
    <None Include="buildTransitive/Themia.Data.Migrations.targets" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
