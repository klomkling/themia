<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Neutral cross-framework package: MUST include net8.0 (cross-framework reuse). -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Themia.Conversations.AspNetCore</PackageId>
    <Description>HTTP surface for Themia.Conversations: minimal-API endpoints for the guest link exchange, listing, posting (JSON and multipart), read marks and attachment download, with a per-conversation guest cookie, a CSRF header, boundary validation and built-in rate limits. The host supplies identity; the package never decides it.</Description>
    <PackageTags>themia;conversations;chat;aspnetcore;guest</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Themia.Conversations/Themia.Conversations.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Themia.Conversations.AspNetCore.Tests" />
  </ItemGroup>
</Project>
