<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Neutral cross-framework package: MUST include net8.0 (cross-framework reuse). -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Themia.Imaging</PackageId>
    <Description>Neutral image-processing core: downscale, bake in EXIF orientation, strip metadata, and re-encode — with the decompression-bomb guard a hand-rolled processor omits.</Description>
    <!-- Version is inherited from Directory.Build.props (shared). Do not set it here. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- SkiaSharp's managed assembly plus the Linux native codec.

         The package used to ship managed SkiaSharp only, on the principle that a native codec is a host
         decision. That principle turned out to be already lost upstream and to cost us the one platform
         that matters: SkiaSharp itself declares NativeAssets.macOS and .Win32 transitively for every
         modern TFM — 83 MB a consumer receives without asking — while Linux is opt-in. So the "neutral"
         package was neutral about exactly one RID, and it was the RID every deployment runs. A developer
         Mac worked, the package looked self-contained, and the container threw at the first decode
         (coord #0110). Linux is now supplied too, so it works everywhere out of the box.

         macos is referenced with PrivateAssets=all purely to stop transitive pinning promoting it into
         our nuspec as a DIRECT dependency; consumers still receive it from SkiaSharp itself. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp.NativeAssets.macos" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Themia.Imaging.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
