<Project>

  <!--
    Auto-imported (buildTransitive/{PackageId}.props) into every consumer that pulls this package in,
    direct or transitive. Flips the flag Themia.Data.Migrations.targets checks at build time — see
    that file (in the Themia.Data.Migrations package) for why the check lives in buildTransitive/ and
    not build/.
  -->

  <PropertyGroup>
    <ThemiaMigrationEngineSelected>true</ThemiaMigrationEngineSelected>
  </PropertyGroup>

</Project>
