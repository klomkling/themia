<Project>

  <!--
    Repo-wide build + package settings for all Themia projects.
    NOTE: TargetFrameworks is deliberately NOT set here — it varies per layer
    (neutral cores = net8.0;net10.0, framework/modules = net10.0). Each csproj
    sets its own. Tests override GenerateDocumentationFile/IsPackable.
  -->

  <PropertyGroup Label="Compiler">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup Label="Version">
    <!--
      Single shared version: all Themia packages release together at one version
      (single-version monorepo, mirroring Idevs.Net.CoreLib). release.yml reads
      this value. Bump here to cut a release. Split per-package later only if
      release cadences genuinely diverge.
    -->
    <Version>0.21.4</Version>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Sarawut Phaekuntod</Authors>
    <Company>Idevs</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/klomkling/themia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/klomkling/themia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!--
    Pack a package's README.md into its nupkg so it renders on nuget.org.

    Conditional on the file existing, because most packages do not have one yet and
    PackageReadmeFile pointing at a missing file fails the pack with NU5039 rather than warning.
    So this changes nothing for a project without a README and needs no per-project opt-in for one
    that gains a README later.

    Why it matters beyond tidiness: coord #0101 asked for the ImageSharp licence finding to live
    somewhere a reader would actually meet it rather than in a props comment. It went into
    Themia.Imaging's README — which was in the repo and NOT in the package, so nuget.org showed
    nothing. A document nobody can reach is the same as no document.
  -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
